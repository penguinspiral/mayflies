# Global ignore for host/target generated configuration & build artifacts
hosts/*/*/*

# Image configuration including auto scripts exclusion
!hosts/*/*/auto/
!hosts/*/*/auto/clean
!hosts/*/*/auto/config
!hosts/*/*/auto/config.d/
!hosts/*/*/auto/config.d/**

# Image target specific environment variables
!hosts/*/*/target.env

# Image target readme markdown
!hosts/*/*/README.md
