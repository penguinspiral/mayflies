# Global ignore for host/target generated configuration & build artifacts
host/*/*/*

# Host configuration including auto scripts exclusion
!host/*/*/auto/
!host/*/*/auto/clean
!host/*/*/auto/config
!host/*/*/auto/config.d/
!host/*/*/auto/config.d/**

# Host target specific environment variables
!host/*/*/target.env

# Host target readme markdown
!host/*/*/README.md
