# Consumed by the rsync-mayflies.service unit file
RSYNC_OPTS="--itemize-changes \
            --recursive \
            --times \
            --copy-links \
            --modify-window=1 \
            --whole-file \
            --fsync \
            --delete-delay"

# Rendered at build-time (.envsubst extension)
# Prevents accidental removal of running Mayflies Live ISO
RSYNC_EXCLUDE="--exclude=${MAYFLIES_LB_IMAGE_ISO}"
