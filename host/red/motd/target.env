# "Target" scoped environment variables
# Overridable at makefile build invocation time

# Extends the host's '_base' target configuration (commit SHA)
MAYFLIES_HOST_BASE_SHA=27c299df85639ea536e257fe548e71bac563757c

MAYFLIES_LB_DEBIAN_RELEASE=trixie
# https://snapshot.debian.org/ -- valid formats: yyyymmddThhmmssZ, yyyymmdd
MAYFLIES_LB_MIRROR=http://snapshot.debian.org/archive/debian/20260816
