# "Host" scoped, "target" agnostic environment variables
# Overridden by duplicate "target" scoped environment variables
# User customisable environment variables ('MAYFLIES_' prefix)

# udev(7)/systemd-udev(8) generated '/dev/disk/by-id' variant
# Quoted, space separated list when handling multiple disks
MAYFLIES_DISK_IDS=nvme-Samsung_SSD_990_EVO_Plus_1TB_S7U5NJ0Y718826Z
MAYFLIES_HOSTNAME=ylw

# live-config(7) runtime user
# Password creation via mkpasswd(1) (included with 'whois' package)
# Create password for chpasswd(8) ingestion (/etc/shadow)
# cspell:disable-next-line
MAYFLIES_LIVE_PASSWORD=$y$j9T$ZQOFkgZCebsmdxMWJXLbs0$E/ZJ4qzKa19817qDMUM9KpKtYfG08QZbsXOBAs2XoF0
MAYFLIES_LIVE_USERNAME=debian
