\033[38;2;179;71;0m                        "Y88P"              "Y88P"\033[0m
'

row() { printf "\033[1;97m»\033[0m \033[1;97m%-16s\033[0m\033[1;33m%s\033[0m\n" "$1" "$2"; }

echo
row "Target:" "${MAYFLIES_TARGET:-unknown}"
row "Build SHA:" "${MAYFLIES_TARGET_COMMIT_HASH:-unknown}"
row "Build mirror:" "${MAYFLIES_LB_MIRROR:-unknown}"
row "live-build(7):" "${MAYFLIES_LB_VERSION:-unknown}"
row "Debian release:" "${MAYFLIES_LB_DEBIAN_RELEASE:-unknown}"
echo
