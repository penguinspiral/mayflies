#!/usr/bin/env bash

# target.env key value overrides take precedent
declare -a ENV_FILES=(/etc/default/mayflies/{live-build,target}.env)

# Safely export key value pairs
for file in "${ENV_FILES[@]}"; do
  if [[ -f "${file}" ]]; then
    while IFS='=' read -r key val || [[ -n "${key}" ]]; do
      [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      export "${key}=${val}"
    done < "${file}"
  fi
done

printf '\033[38;2;255;242;0m888b     d888                    .d888 888\033[0m
\033[38;2;247;225;0m8888b   d8888                   d88P"  888\033[0m
\033[38;2;240;208;0m88888b.d88888                   888    888\033[0m
\033[38;2;232;191;0m888Y88888P888  8888b.  888  888 888888 888 888  888\033[0m
\033[38;2;224;174;0m888 Y888P 888     "88b 888  888 888    888 888  888\033[0m
\033[38;2;217;157;0m888  Y8P  888 .d888888 888  888 888    888 888  888\033[0m
\033[38;2;209;139;0m888   "   888 888  888 Y88b 888 888    888 Y88b 888\033[0m
\033[38;2;202;122;0m888       888 "Y888888  "Y88888 888    888  "Y88888\033[0m
\033[38;2;194;105;0m                            888                 888\033[0m
