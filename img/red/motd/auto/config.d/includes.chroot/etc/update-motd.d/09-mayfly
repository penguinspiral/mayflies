#!/usr/bin/env bash

# target.env key value overrides take precedent
declare -a ENV_FILES=(/etc/default/mayflies/{live-build,target}.env)

# Safely export key value pairs
for file in "${ENV_FILES[@]}"; do
  if [[ -f "${file}" ]]; then
    while IFS='=' read -r key val || [[ -n "${key}" ]]; do
      [[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      export "${key}=${val}"
    done < "${file}"
  fi
done

printf '\033[38;2;255;85;85m888b     d888                    .d888 888\033[0m
\033[38;2;240;77;77m8888b   d8888                   d88P"  888\033[0m
\033[38;2;226;68;68m88888b.d88888                   888    888\033[0m
\033[38;2;211;60;60m888Y88888P888  8888b.  888  888 888888 888 888  888\033[0m
\033[38;2;196;51;51m888 Y888P 888     "88b 888  888 888    888 888  888\033[0m
\033[38;2;181;43;43m888  Y8P  888 .d888888 888  888 888    888 888  888\033[0m
\033[38;2;166;34;34m888   "   888 888  888 Y88b 888 888    888 Y88b 888\033[0m
\033[38;2;152;26;26m888       888 "Y888888  "Y88888 888    888  "Y88888\033[0m
\033[38;2;137;17;17m                            888                 888\033[0m
\033[38;2;122;9;9m                       Y8b d88P            Y8b d88P\033[0m
\033[38;2;107;0;0m                        "Y88P"              "Y88P"\033[0m
'

row() { printf "\033[1;97m»\033[0m \033[1;97m%-16s\033[0m\033[1;31m%s\033[0m\n" "$1" "$2"; }

echo
row "Target:" "${MAYFLIES_TARGET:-unknown}"
row "Build SHA:" "${MAYFLIES_TARGET_COMMIT_HASH:-unknown}"
row "Build mirror:" "${MAYFLIES_LB_MIRROR:-unknown}"
row "live-build(7):" "${MAYFLIES_LB_VERSION:-unknown}"
row "Debian release:" "${MAYFLIES_LB_DEBIAN_RELEASE:-unknown}"
echo
