\033[38;2;0;169;215m888Y88888P888  8888b.  888  888 888888 888 888  888\033[0m
\033[38;2;0;149;201m888 Y888P 888     "88b 888  888 888    888 888  888\033[0m
\033[38;2;0;129;188m888  Y8P  888 .d888888 888  888 888    888 888  888\033[0m
\033[38;2;0;110;174m888   "   888 888  888 Y88b 888 888    888 Y88b 888\033[0m
