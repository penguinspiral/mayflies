# "Host" scoped, "target" agnostic environment variables
# Overridden by duplicate "target" scoped environment variables

# User customisable environment variables ('MAYFLIES_' prefix)
MAYFLIES_HOSTNAME=blu
# udev(7)/systemd-udev(8) generated '/dev/disk/by-id' variant
# Space separated list of disks available
MAYFLIES_DISK_IDS="nvme-Samsung_SSD_990_EVO_Plus_1TB_S7U5NJ0Y718960L"
