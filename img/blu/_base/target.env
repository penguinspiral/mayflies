# "Target" scoped environment variables
# Overridable at makefile build invocation time

# Live-build(7) specific environment variables consumed at build-time
# https://snapshot.debian.org/ -- valid formats: yyyymmddThhmmssZ, yyyymmdd
LB_MIRROR=http://snapshot.debian.org/archive/debian/20260131
LB_DEBIAN_RELEASE=trixie
